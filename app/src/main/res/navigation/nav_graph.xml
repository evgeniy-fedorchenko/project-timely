<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/authFragment">

    <!-- AuthFragment -->
    <fragment
        android:id="@+id/authFragment"
        android:name="com.efedorchenko.timely.ui.fragment.AuthFragment"
        android:label="AuthFragment">
        <action
            android:id="@+id/action_authFragment_to_mainWorkerFragment"
            app:destination="@id/mainWorkerFragment" />
        <action
            android:id="@+id/action_authFragment_to_mainBossFragment"
            app:destination="@id/mainWorkerFragment" />
        <action
            android:id="@+id/action_authFragment_to_registerDispatcherFragment"
            app:destination="@id/registerDispatcherFragment" />
    </fragment>

    <!-- MainBossFragment and MainWorkerFragment -->
    <fragment
        android:id="@+id/mainWorkerFragment"
        android:name="com.efedorchenko.timely.ui.fragment.MainWorkerFragment"
        android:label="MainWorkerFragment" />

    <fragment
        android:id="@+id/mainBossFragment"
        android:name="com.efedorchenko.timely.ui.fragment.MainBossFragment"
        android:label="MainBossFragment">
        <action
            android:id="@+id/action_mainBossFragment_to_mainWorkerFragment"
            app:destination="@id/registerDispatcherFragment" />
    </fragment>

    <!-- register fragments -->
    <fragment
        android:id="@+id/registerDispatcherFragment"
        android:name="com.efedorchenko.timely.ui.fragment.RegisterDispatcherFragment"
        android:label="MainFragment">
        <action
            android:id="@+id/dispatch_to_registerFragment"
            app:destination="@id/registerFragment" />
        <action
            android:id="@+id/dispatch_to_registerCreatorFragment"
            app:destination="@id/registerCreatorFragment" />
    </fragment>

    <fragment
        android:id="@+id/registerFragment"
        android:name="com.efedorchenko.timely.ui.fragment.RegisterFragment"
        android:label="RegisterFragment">
        <argument
            android:name="userType"
            app:argType="string" />
        <argument
            android:name="withSpace"
            app:argType="boolean"
            android:defaultValue="true" />
    </fragment>
    <fragment
        android:id="@+id/registerCreatorFragment"
        android:name="com.efedorchenko.timely.ui.fragment.RegisterCreatorFragment"
        android:label="RegisterCreatorFragment" />

</navigation>
